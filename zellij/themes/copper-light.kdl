// Copper light: the ContextMatrix Copper palette (web/src/index.css).
// Catppuccin's layout through the same slot mapping as the AIM theme; copper marks
// the focused frame and selected tab, and emphasis falls back to a readable colour.
themes {
    copper-light {
        text_unselected {
            base 37 35 43
            background 240 238 243
            emphasis_0 121 56 9
            emphasis_1 40 93 118
            emphasis_2 33 99 70
            emphasis_3 164 42 59
        }
        text_selected {
            base 37 35 43
            background 178 170 186
            emphasis_0 121 56 9
            emphasis_1 40 93 118
            emphasis_2 33 99 70
            emphasis_3 37 35 43
        }
        ribbon_selected {
            base 255 255 255
            background 168 61 23
            emphasis_0 255 176 188
            emphasis_1 255 255 255
            emphasis_2 210 185 237
            emphasis_3 179 196 255
        }
        ribbon_unselected {
            base 255 255 255
            background 87 79 96
            emphasis_0 210 185 237
            emphasis_1 241 238 245
            emphasis_2 179 196 255
            emphasis_3 210 185 237
        }
        table_title {
            base 168 61 23
            background 0
            emphasis_0 121 56 9
            emphasis_1 40 93 118
            emphasis_2 33 99 70
            emphasis_3 114 80 150
        }
        table_cell_selected {
            base 37 35 43
            background 178 170 186
            emphasis_0 121 56 9
            emphasis_1 40 93 118
            emphasis_2 33 99 70
            emphasis_3 37 35 43
        }
        table_cell_unselected {
            base 37 35 43
            background 240 238 243
            emphasis_0 121 56 9
            emphasis_1 40 93 118
            emphasis_2 33 99 70
            emphasis_3 114 80 150
        }
        list_selected {
            base 37 35 43
            background 178 170 186
            emphasis_0 121 56 9
            emphasis_1 40 93 118
            emphasis_2 33 99 70
            emphasis_3 37 35 43
        }
        list_unselected {
            base 37 35 43
            background 240 238 243
            emphasis_0 121 56 9
            emphasis_1 40 93 118
            emphasis_2 33 99 70
            emphasis_3 114 80 150
        }
        frame_selected {
            base 168 61 23
            background 0
            emphasis_0 121 56 9
            emphasis_1 40 93 118
            emphasis_2 114 80 150
            emphasis_3 0
        }
        frame_highlight {
            base 121 56 9
            background 0
            emphasis_0 164 42 59
            emphasis_1 168 61 23
            emphasis_2 121 56 9
            emphasis_3 121 56 9
        }
        exit_code_success {
            base 33 99 70
            background 0
            emphasis_0 40 93 118
            emphasis_1 255 255 255
            emphasis_2 114 80 150
            emphasis_3 52 82 163
        }
        exit_code_error {
            base 164 42 59
            background 0
            emphasis_0 133 83 19
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 114 80 150
            player_2 52 82 163
            player_3 0
            player_4 133 83 19
            player_5 40 93 118
            player_6 0
            player_7 164 42 59
            player_8 0
            player_9 0
            player_10 0
        }
    }
}
